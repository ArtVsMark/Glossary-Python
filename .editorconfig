# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,html,css,js,toml}]
indent_size = 2

[*.md]
# В Markdown два пробела в конце строки — это жёсткий перенос.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[python_glossary.html]
# Генерируемый файл: форматирование задаёт сборщик, а не редактор.
trim_trailing_whitespace = false
insert_final_newline = false
